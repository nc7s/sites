extends _layout.pug

block append styles
	link(href='home.css' rel='stylesheet')

block content
	-
		function yearName(year) {
			return year
				.toString()
				.split('')
				.map((d) => '零壹貳叄肆伍六柒捌玖'[d])
				.join('')
		}

		function dayName(day) {
			day = Number(day)
			return (
				['', '十', '廿', '卅'][Math.floor(day / 10)] +
				[''].concat('一二三四五六七八九十'.split(''))[day % 10]
			)
		}

		const links = [
			{ label: '主页', url: '/' },
			{ label: '关于我', url: '/about' },
		]

		const articleData = [
			{
