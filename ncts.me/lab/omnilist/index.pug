			{ title: '2022 年 7 月和 8 月总结', date: '2022-09-03', url: '/some' },
		]

		const organized = articleData.reduce((acc, cur, _) => {
			const [year, month] = cur.date.split('-').map(Number)
			if (acc[year] === undefined) {
				acc[year] = {
					[month]: [],
				}
			}
			if (acc[year][month] === undefined) {
				acc[year][month] = []
			}
			acc[year][month].push(cur)
			return acc
		}, {})
	div.omnilist
		h1 某博客
		div.link-list
			a(href='/') 首页
			a(href='/about') 关于这里
		div.article-list
			each year in Object.keys(organized).sort().reverse()
				h2.year= yearName(year)
				each month in Object.keys(organized[year]).sort().reverse()
					h3.month= dayName(month) + '月'
					ul.article-list
						- const thisMonth = organized[year][month].sort(a => a.date)
						- for(let i = 0; i < thisMonth.length; i += 1)
							- const day = thisMonth[i].date.split('-')[2]
							- const sameDay = thisMonth[i].date === thisMonth[i - 1]?.date
							unless sameDay
								span.day= dayName(day) + '日'
							li
								a(href=thisMonth[i].url class=(sameDay ? 'multi-article-day' : ''))= thisMonth[i].title
